# User permissions (run 'id' in terminal to verify)
UID=1000
GID=1000

# Database Secrets
POSTGRES_USER=user_name_here
POSTGRES_PASSWORD=password_here
POSTGRES_DB=growhub
POSTGRES_HOST=database_host_IP_here

# InfluxDB Secrets
# INFLUXDB_URL must be http://influxdb:8086 when running inside Docker.
INFLUXDB_URL=http://localhost:8086
INFLUXDB_USER=user_name_here
INFLUXDB_PASSWORD=password_here
INFLUXDB_ORG=growhub_org
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=your_influxdb_token_here

# MQTT Configuration Template
# MQTT_BROKER must be mqtt-broker when running inside Docker.
MQTT_BROKER=broker_IP_address_here
MQTT_USER=user_name_here
MQTT_PASSWORD=password_here
MQTT_PORT=1883

# --- Backend Django (v2) ----------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_PORT=5432
GROWHUB_PAIRING_TTL_HOURS=24
GROWHUB_PAIRING_MAX_ATTEMPTS=5
GROWHUB_DEVICE_STALE_AFTER=300
GROWHUB_TELEMETRY_RETENTION_MONTHS=24
