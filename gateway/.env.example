# GrowHub — variables d'environnement (modèle à copier en gateway/.env).
#
# La pile v2 (docker-compose.yml) lit ce fichier ; l'ancienne pile
# (docker-compose.v1.yml) le lit aussi, d'où la présence des variables InfluxDB.

# --- Permissions des fichiers Mosquitto (voir `id -u` / `id -g`) -------------
UID=1000
GID=1000

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
# Nom d'hôte et IP du Pi : le tableau de bord et l'admin sont servis par le front
# (3001) et le backend (8000).
DJANGO_ALLOWED_HOSTS=growhub.local,localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (base unique : applicatif + télémétrie) ----------------------
POSTGRES_USER=user_name_here
POSTGRES_PASSWORD=password_here
POSTGRES_DB=growhub
# Nom du service dans le réseau Compose.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Compte de service MQTT (celui du backend) -------------------------------
# MQTT_BROKER = nom du service Compose. Ce compte doit exister dans
# gateway/mosquitto/config/password_file (voir docs/gateway_setup.md).
MQTT_BROKER=mqtt-broker
MQTT_PORT=1883
MQTT_USER=growhub_api
MQTT_PASSWORD=password_here

# --- Réglages GrowHub --------------------------------------------------------
GROWHUB_PAIRING_TTL_HOURS=24
GROWHUB_PAIRING_MAX_ATTEMPTS=5
GROWHUB_DEVICE_STALE_AFTER=300
GROWHUB_TELEMETRY_RETENTION_MONTHS=24
# Adresse du broker telle que le BOÎTIER la voit (IP du Pi sur le réseau,
# jamais le nom du service Compose) : elle part dans le secrets.py et dans
# le message d'appairage.
GROWHUB_DEVICE_BROKER=192.168.1.113
GROWHUB_DEVICE_BROKER_PORT=1883

# --- Administration Mosquitto ------------------------------------------------
# Les valeurs par défaut visent gateway/mosquitto/config depuis le dépôt monté
# dans le conteneur backend (/app) : ne les changer que si l'arborescence change.
GROWHUB_MOSQUITTO_CONFIG_DIR=/app/gateway/mosquitto/config
GROWHUB_MOSQUITTO_PASSWORD_FILE=password_file
GROWHUB_MOSQUITTO_ACL_FILE=acl_file
# Vide : c'est le service `mqtt-reloader` qui envoie le SIGHUP au broker.
GROWHUB_MQTT_RELOAD_COMMAND=

# --- Tableau de bord ---------------------------------------------------------
# Cible des `rewrites` de Next (le front sert /api et proxifie vers Django).
GROWHUB_API_URL=http://backend:8000

# --- Sauvegardes (tools/backup.sh) -------------------------------------------
GROWHUB_BACKUP_DIR=/home/marius/growhub_backups

# --- Ancienne pile v0.1 (docker-compose.v1.yml, retour arrière) --------------
# INFLUXDB_URL doit être http://influxdb:8086 dans Docker.
INFLUXDB_URL=http://localhost:8086
INFLUXDB_USER=user_name_here
INFLUXDB_PASSWORD=password_here
INFLUXDB_ORG=growhub_org
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=your_influxdb_token_here
