# User permissions (run 'id' in terminal to verify)
UID=1000
GID=1000

# Database Secrets
POSTGRES_USER=user_name_here
POSTGRES_PASSWORD=password_here
POSTGRES_DB=growhub

# InfluxDB Secrets
INFLUXDB_USER=user_name_here
INFLUXDB_PASSWORD=password_here
INFLUXDB_ORG=growhub_org
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=your_influxdb_token_here

# MQTT Configuration Template
MQTT_BROKER=broker_IP_address_here
MQTT_USER=user_name_here
MQTT_PASSWORD=password_here
MQTT_PORT=1883
